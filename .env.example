# OpenAI API Configuration
# Required for LLM features (required in production, optional in development)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Configuration
# Port for the Express server (default: 3000)
PORT=3000

# Environment mode: development, production, etc. (default: development)
NODE_ENV=development

# Database Configuration
# Path to the SQLite database file (default: ./data/scanner.db)
DB_PATH=./data/scanner.db

# Analysis Limits Configuration
# Maximum number of issues to include in analysis (default: 50)
# Controls how many of the most recent issues are considered
MAX_ISSUES=50

# Maximum characters per issue body before truncation (default: 1000)
# Each issue body will be truncated to this length if longer
MAX_BODY_CHARS=1000

# Maximum total characters across all issues in analysis (default: 30000)
# Stops adding issues once this limit is reached to control context size and costs
MAX_TOTAL_CHARS=30000

# Scan Limits Configuration
# Maximum number of issues to fetch during scan (optional, default: fetch all)
# When set, only the most recent N issues will be fetched, stopping pagination early
# This helps control API usage and storage for repositories with many open issues
MAX_SCAN_ISSUES=100
