# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/scanner.db

# OpenAI API (required for analysis features)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub API (optional - if not set, uses unauthenticated rate limits)
# GITHUB_TOKEN=ghp_your_github_token_here

# Analysis Configuration
# Optional: Hard limit on number of issues to analyze (default: no limit)
# MAX_ANALYSIS_ISSUES=100

# Scan Configuration
# Optional: Limit number of issues fetched during scan (default: no limit)
# MAX_SCAN_ISSUES=1000

# Token-based Configuration (automatically calculated if not set)
# Model context window (default: 128000 for GPT-4o)
# MODEL_CONTEXT_WINDOW=128000

# Optional: Override automatic chunk sizing
# MAX_TOKENS_PER_CHUNK=38400
# MAX_TOKENS_FOR_SYNTHESIS=51200

# Optional: Total token budget across all analysis calls
# MAX_TOTAL_TOKENS=200000

# Model Pricing (optional - defaults to GPT-4o pricing)
# Cost per 1K input tokens (default: $0.0025 for GPT-4o)
# COST_PER_INPUT_TOKEN_1K=0.0025

# Cost per 1K output tokens (default: $0.01 for GPT-4o)
# COST_PER_OUTPUT_TOKEN_1K=0.01
